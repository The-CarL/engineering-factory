# Names only. Do not source this file; configure approved values outside Git.
# Non-secret target configuration (actual values stay private):
FACTORY_GITHUB_OWNER=
# Cloud activation explicitly selects factory-token; explicit cli is for reviewed local hosts.
FACTORY_GITHUB_CREDENTIAL_SOURCE=
FACTORY_VERCEL_TEAM_ID=
FACTORY_VERCEL_TEAM_SLUG=
FACTORY_AWS_ACCOUNT_ID=
FACTORY_AWS_REGION=
FACTORY_AWS_ROLE_NAME=
# App-specific Vercel link context, only after explicit project selection:
VERCEL_PROJECT_ID=
VERCEL_ORG_ID=
# Secret variable NAMES only. Do not put values here or in chat/commands.
GH_TOKEN=
FACTORY_GITHUB_TOKEN=
# CLI-capable: approved personal direct secret env; REST-only network secret is a separate alternative.
VERCEL_TOKEN=
# Optional short-lived AWS session mechanism; do not create long-lived keys:
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=
AWS_DEFAULT_REGION=
# Versioned runtime/source selection and private artifact locations:
FACTORY_SOURCE_REPOSITORY=
FACTORY_SOURCE_REVISION=
FACTORY_RUNTIME_DIRECTORY=
FACTORY_RUNTIME_MANIFEST=
FACTORY_PRIVATE_ROOT=
# Optional project session context (both together), request duration and trusted IaC/SDK exec:
FACTORY_PROJECT_ID=
FACTORY_ENVIRONMENT=
FACTORY_AWS_SESSION_SECONDS=
FACTORY_AWS_EXECUTABLE=
FACTORY_AWS_EXECUTABLE_SHA256=
FACTORY_AWS_APP_BOUNDARY_ARN=
FACTORY_AWS_APP_POLICY_ARN=
# Optional dedicated private durable context store and explicitly selected known app:
FACTORY_CONTEXT_REPOSITORY=
FACTORY_CONTEXT_DIRECTORY=
FACTORY_PROJECT_REPOSITORY=
FACTORY_PROJECT_APP=
